# ChipStock Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=chipstock

# Admin Password Bcrypt Hash
# Generate using `npm run hash-password yourSecretPassword`
ADMIN_PASSWORD_HASH=$2a$10$wK1Vl1GzJ0m3fK9I...

# JWT Session Secret
SESSION_SECRET=replace_with_a_secure_random_string_in_production
